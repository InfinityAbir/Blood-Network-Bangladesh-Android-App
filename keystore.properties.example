# Copy this file to keystore.properties (same directory, repo root) and fill in the
# real values after generating your release keystore. keystore.properties is gitignored —
# never commit it or the .jks file. See README.md "Release build & signing" for the
# keytool command that creates the keystore these values point at.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=bloodnetwork
keyPassword=CHANGE_ME
